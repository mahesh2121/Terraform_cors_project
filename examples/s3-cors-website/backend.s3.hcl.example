# Copy this file to backend.s3.hcl (gitignored) and adjust the values.
# Then run: terraform init -backend-config=backend.s3.hcl

bucket         = "my-terraform-state-bucket12121"
key            = "terraform/state/terraform.tfstate"
region         = "ap-south-1"
encrypt        = true
dynamodb_table = "terraform-lock-table"
